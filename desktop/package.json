{
  "name": "infinity-socials-desktop",
  "version": "1.0.0",
  "description": "Infinity Socials - Steam Style Native Desktop Client",
  "main": "main.js",
  "scripts": {
    "start": "electron . --url=https://infinity-socials.vercel.app",
    "prod": "electron . --url=https://infinity-socials.vercel.app",
    "dev": "electron . --url=https://infinity-socials.vercel.app",
    "local": "electron . --url=http://localhost:3000",
    "build:exe": "electron-builder --win nsis",
    "build:portable": "electron-builder --win portable",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.infinitysocials.desktop",
    "productName": "Infinity Socials",
    "copyright": "Copyright © 2026 Infinity Socials",
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Infinity Socials"
    },
    "files": [
      "main.js",
      "config.js",
      "preload.js",
      "tray.js",
      "assets/**/*",
      "ui/**/*",
      "package.json"
    ]
  },
  "keywords": [],
  "author": "Infinity Socials",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@electron/remote": "^2.1.3",
    "@types/node": "^26.4.1",
    "dotenv": "^17.4.2",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-is-dev": "^3.0.1"
  }
}
